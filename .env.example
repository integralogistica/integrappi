# SICE-TAC / RNDC (no incluya secretos en este archivo)
RNDC_USERNAME=
RNDC_PASSWORD=
# Reutiliza MONGO_URI, la conexión MongoDB existente del backend.
MONGO_URI=
MONGODB_DATABASE=sicetac
MONGODB_COLLECTION=consultas
RNDC_ENVIRONMENT=production
# Permite reemplazar/confirmar el endpoint, especialmente en pruebas.
RNDC_SOAP_URL=

# URL pública del frontend que recibe los QR de Estudios de Seguridad.
# Ejemplo: https://integrapp.example.com/VerificarEstudio
# Si se omite, el QR conserva el endpoint JSON histórico del backend.
SEGURIDAD_VERIFICACION_URL_PUBLICA=
